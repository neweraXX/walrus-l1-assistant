# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Walrus Memory (mainnet) ---
# Delegate key + account ID from the dashboard: https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Namespace prefix, keeps this project's memories apart from anything else on the same account.
# Walrus Memory is append-only: change the prefix to start from a clean slate.
NAMESPACE_PREFIX=l1demo

# --- LLM: any OpenAI-compatible endpoint (this project runs on Gemini, not Claude/GPT) ---
# Examples (check the model names are still current):
#   Gemini  : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com                                 LLM_MODEL=deepseek-chat
#   Qwen    : LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1     LLM_MODEL=qwen-plus
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Fallback models (comma separated) when the main one returns 503/429.
# The FIRST fallback is also used as the "strong" model for teach-normalisation and second opinions.
LLM_FALLBACK_MODELS=

# --- Zalo bot (only needed for `npm start`; cli/check/demo run without it) ---
ZALO_BOT_TOKEN=
# Group chat_ids allowed to use the bot, comma separated. Empty = all groups
# (the bot logs every chat_id so you can copy it here).
ALLOWED_CHAT_IDS=
# User ids allowed to DM the bot (DMs are ignored for everyone else).
ALLOWED_DM_USER_IDS=

# --- Knowledge ---
# Folder of .md docs the bot answers from (indexed by `npm run index-kb`).
KNOWLEDGE_DIR=mock-sharepoint
# File where every "dạy:" (teach) is also appended, for the weekly human review. Empty = off.
ADDENDUM_FILE=logs/addendum.md
# Display names whose teachings count as approved (comma separated).
KB_APPROVERS=Ha

# --- Widespread-incident detector ---
INCIDENT_WINDOW_MINUTES=60
INCIDENT_MIN_REPORTS=3

# --- Optional: read-only tool service (Jira / call-center stats) ---
# Not part of this repo (it holds internal tokens). Leave empty to disable tool questions.
TOOL_URL=
TICKET_BROWSE_URL=
